% tminus.sty -- shared style for every tminus LaTeX output (packs, formulas, mock, cram).
% Course-agnostic. ASCII only. Every macro tminus defines is namespaced so it cannot clash
% with user or course macros (the DME session broke on a \given clash).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tminus}[2026/11/22 tminus exam sprint style]

\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{geometry}
\RequirePackage{amsmath,amssymb,mathtools,bm}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs,tabularx,multirow}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{siunitx}
\RequirePackage{multicol}
\RequirePackage{fancyhdr}
\RequirePackage{tikz}
\RequirePackage[hidelinks]{hyperref}

\geometry{a4paper,margin=1.8cm,top=2.3cm,headheight=26pt,headsep=10pt}
\graphicspath{{./figs/}{./}}
\setlist{leftmargin=*,itemsep=0.35em,topsep=0.4em}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}
\linespread{1.08}
\sloppy
\setlength{\emergencystretch}{3em}

% ---- header: \tmcourse and \tmdoc are set by the document; long titles are truncated
% into a fixed-width box so they never overlap the page number.
\newcommand{\tmcourse}{}
\newcommand{\tmdoc}{}
\newcommand{\tmsetcourse}[1]{\renewcommand{\tmcourse}{#1}}
\newcommand{\tmsetdoc}[1]{\renewcommand{\tmdoc}{#1}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\parbox[b]{0.62\textwidth}{\raggedright\strut\tmcourse}}
\fancyhead[R]{\small\parbox[b]{0.32\textwidth}{\raggedleft\strut\tmdoc}}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}

% ---- boxes
\tcbset{tmbase/.style={breakable,enhanced,boxrule=0.6pt,arc=1.5mm,left=8pt,right=8pt,
  top=6pt,bottom=6pt,before skip=12pt,after skip=12pt,fonttitle=\bfseries\small}}
\newtcolorbox{tmsnapshot}[1][60-second snapshot]{tmbase,colback=blue!4,colframe=blue!55!black,title={#1}}
\newtcolorbox{tmrecipe}[1][Recipe]{tmbase,colback=green!4,colframe=green!45!black,title={#1}}
\newtcolorbox{tmexample}[1][Worked example]{tmbase,colback=white,colframe=black!55,title={#1}}
\newtcolorbox{tmtrap}[1][Common trap]{tmbase,colback=red!3,colframe=red!60!black,title={#1}}
\newtcolorbox{tmconvention}[1][Professor's convention (overrides the book)]{tmbase,colback=orange!5,colframe=orange!70!black,title={#1}}
\newtcolorbox{tmdrill}[1][Next: drill]{tmbase,colback=violet!4,colframe=violet!60!black,title={#1}}
\newtcolorbox{tmverify}[1][Verification report]{tmbase,colback=gray!5,colframe=gray!60!black,title={#1}}

% ---- inline markers
% \examgiven: formula is printed on the paper; \examremember: must memorise.
\newcommand{\examgiven}{\textcolor{gray!70!black}{\scriptsize\,[given]}}
\newcommand{\examremember}{\textcolor{red!70!black}{\scriptsize\,[remember]}}
% \flag{...}: a book or slide error, always with the correction and how it was verified.
\newcommand{\flag}[1]{\textcolor{red!70!black}{\textbf{[FLAG]}~#1}}
% \approxval{value}{method}: a value read from a chart or figure.
\newcommand{\approxval}[2]{#1\textsuperscript{\,\textcolor{orange!70!black}{approx.}}\footnote{Read from #2.}}
\newcommand{\unverified}[1]{\textcolor{orange!80!black}{[UNVERIFIED]}~#1}
\newcommand{\tmans}[1]{\par\medskip\noindent\fbox{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{\textbf{Answer:} #1}}\par}
\providecommand{\degree}{\ensuremath{^\circ}}
\newcommand{\tmsource}[1]{\textcolor{gray!70!black}{\footnotesize(#1)}}

% ---- readable questions and solutions (one idea per line, room to breathe)
% \begin{tmgiven} \item $V = 208$ V \item ... \end{tmgiven}: the data, one item per line.
\newenvironment{tmgiven}{\par\noindent\textbf{Given}\par\vspace{-0.3em}
  \begin{itemize}[itemsep=0.1em,topsep=0.2em,label=\textcolor{gray}{\textbullet}]}{\end{itemize}}
% \begin{tmfind} \item ... \end{tmfind}: what is asked, numbered (i), (ii).
\newenvironment{tmfind}{\par\noindent\textbf{Find}\par\vspace{-0.3em}
  \begin{enumerate}[label=(\roman*),itemsep=0.1em,topsep=0.2em]}{\end{enumerate}}
% \begin{tmsolution} \item <what this step does> \[ equation \] ... \end{tmsolution}
\newenvironment{tmsolution}{\par\medskip\noindent\textbf{Solution}\par\vspace{-0.2em}
  \begin{enumerate}[label=\textbf{\arabic*.},itemsep=0.7em,topsep=0.3em]
  \setlength{\abovedisplayskip}{4pt}\setlength{\belowdisplayskip}{4pt}}{\end{enumerate}}
% Mock papers: \begin{tmquestion}{2}{12} text, then tmparts and/or tmoptions \end{tmquestion}
\newenvironment{tmquestion}[2]{\par\bigskip\noindent\textbf{Q#1.}\hfill\textbf{[#2 marks]}\par\smallskip}
  {\par\medskip}
\newenvironment{tmparts}{\begin{enumerate}[label=(\roman*),itemsep=0.4em]}{\end{enumerate}}
\newenvironment{tmoptions}{\begin{enumerate}[label=(\alph*),itemsep=0.15em,topsep=0.3em]}{\end{enumerate}}

% ---- formula sheets
% \tmformula{label}{math}{when to use}{marker}: one sheet line, safe inside multicols.
\newcommand{\tmformula}[4]{\par\noindent\textbf{#1}#4\par\nobreak
  \vspace{-0.6em}\[#2\]\vspace{-0.5em}\par\nobreak{\footnotesize\textit{#3}}\par\smallskip}
\newcommand{\tmfsection}[1]{\par\smallskip{\color{orange!70!black}\bfseries #1}\par\nobreak
  \vspace{-0.3em}\noindent\rule{\linewidth}{0.4pt}\par\nobreak}
% tmsheet: two-column sheet.  tmonepage: dense one-page sheet (the brief says how to shrink if it overflows).
\newenvironment{tmsheet}{\begin{multicols}{2}\small
  \setlength{\abovedisplayskip}{2pt}\setlength{\belowdisplayskip}{2pt}
  \setlength{\abovedisplayshortskip}{1pt}\setlength{\belowdisplayshortskip}{1pt}}
  {\end{multicols}}
% \begin{tmonepage}[columns]{Title}: full-width title, then a dense multi-column page.
\newenvironment{tmonepage}[2][3]{\newgeometry{margin=0.9cm,top=1.6cm,headheight=26pt,headsep=6pt}
  \section*{#2}\begin{multicols}{#1}\footnotesize\setlength{\parskip}{1pt}
  \setlength{\abovedisplayskip}{1pt}\setlength{\belowdisplayskip}{1pt}}
  {\end{multicols}\restoregeometry}
\newcommand{\tmhead}[1]{\par\smallskip{\color{blue!55!black}\bfseries #1}\par}
\newcommand{\tmpt}{\par\noindent\textbullet\ }

\endinput
